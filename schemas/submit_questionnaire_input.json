{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubmitQuestionnaireInput",
  "type": "object",
  "properties": {
    "questionnaire_id": { "type": "string", "format": "uuid" },
    "appointment_id": { "type": "string", "format": "uuid" },
    "patient_id": { "type": "string", "format": "uuid" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": { "type": "string" },
          "raw_patient_input": { "type": "string" },
          "structured_value": { "type": ["string", "number", "boolean", "array"] }
        },
        "required": ["question_id", "raw_patient_input", "structured_value"]
      }
    }
  },
  "required": ["questionnaire_id", "appointment_id", "patient_id", "answers"]
}
