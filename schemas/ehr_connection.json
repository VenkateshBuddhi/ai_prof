{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EhrConnection",
  "type": "object",
  "properties": {
    "connection_id": { "type": "string", "format": "uuid" },
    "ehr_system_id": { "type": "string", "format": "uuid" },
    "hospital_id": { "type": "string", "format": "uuid" },
    "credentials_ref": { "type": ["string", "null"] },
    "webhook_secret_ref": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended", "Closed"] },
    "last_health_check_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["connection_id", "ehr_system_id", "hospital_id", "status"]
}
