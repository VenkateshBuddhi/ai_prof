{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdminUser",
  "type": "object",
  "properties": {
    "admin_user_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "hospital_id": { "type": ["string", "null"], "format": "uuid" },
    "full_name": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "role": { "type": "string", "enum": ["SUPER_ADMIN", "TENANT_ADMIN", "HOSPITAL_ADMIN", "FRONT_DESK", "CLINICAL_STAFF"] },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended", "Closed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["admin_user_id", "tenant_id", "full_name", "email", "role", "status"]
}
