{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Patient",
  "type": "object",
  "properties": {
    "patient_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "ehr_patient_id": { "type": ["string", "null"] },
    "first_name": { "type": "string" },
    "last_name": { "type": "string" },
    "date_of_birth": { "type": ["string", "null"], "format": "date" },
    "phone": { "type": "string" },
    "email": { "type": ["string", "null"], "format": "email" },
    "preferred_hospital_id": { "type": ["string", "null"], "format": "uuid" },
    "preferred_doctor_id": { "type": ["string", "null"], "format": "uuid" },
    "communication_preference": { "type": "string", "enum": ["Voice", "SMS", "Email", "Push"] },
    "language": { "type": "string" },
    "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended", "Closed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["patient_id", "tenant_id", "first_name", "last_name", "phone", "communication_preference", "status"]
}
