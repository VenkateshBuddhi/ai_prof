# Copy to .env and fill in. Stack: LiveKit + LangGraph (Gemini→Groq) + Medplum.

# --- LiveKit (media/rooms) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech I/O ---
DEEPGRAM_API_KEY=        # STT
CARTESIA_API_KEY=        # TTS

# --- Agent LLM: Gemini + Groq with automatic fallback ---
GEMINI_API_KEY=                        # Google Gemini; GOOGLE_API_KEY also accepted (free tier ~20 req/day)
# GEMINI_MODEL=gemini-flash-lite-latest  # flash-lite has the largest free-tier quota
GROQ_API_KEY=                          # Groq
# GROQ_MODEL=openai/gpt-oss-20b        # optional override
# LLM_PRIMARY=gemini                   # which provider is tried first (gemini|groq); the other is fallback

# --- Medplum (FHIR system of record). Omit to disable EHR features (fail-open) ---
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# MEDPLUM_BASE_URL=https://api.medplum.com   # optional

# --- Optional ---
# FILLER_AFTER_SECONDS=4               # speak a filler only if a turn is slower than this (0 disables)
# FILLER_PHRASE=One moment…            # the filler line
# CARTESIA_VOICE=e0e29b11-d0db-40a2-b9cf-2b62d3bc47fc
# LIVEKIT_AGENT_NAME=healthcare-intake       # only for explicit SIP dispatch
# LOG_LEVEL=INFO                             # DEBUG for full detail incl. libraries
# ESCALATION_TRANSFER_TO=tel:+1XXXXXXXXXX    # human-transfer destination on your trunk
# MEDPLUM_DEFAULT_ORG=                        # Organization id for newly-registered patients

# --- Workflow engine + notifications (src/workflows) ---
# NOTIFY_CHANNELS=record                     # comma list: record[,sms]; record = FHIR Communication
# REMINDER_LEAD_MINUTES=1440                 # reminder lead before appt (1440=24h; set ~2 for demos)
# WORKFLOW_POLL_SECONDS=30                   # runner poll interval
# SMS uses TWILIO_ACCOUNT_SID/AUTH_TOKEN/PHONE_NUMBER if NOTIFY_CHANNELS includes 'sms'

# --- Twilio ---
# Twilio is only the SIP trunk. Trunk origination -> LiveKit SIP is configured in
# the Twilio/LiveKit consoles, NOT read from here — no Twilio env vars are needed.
